From cea54e4ace5a9aa5184635109a73dddb2118143f Mon Sep 17 00:00:00 2001
From: Dashboard Fix <fix@dashboard.local>
Date: Sat, 16 May 2026 22:52:23 +0000
Subject: [PATCH] fix: holiday display and online/offline toggle
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- Fix parseHolidaysVN: ngay lễ VN trước đây không được đánh dấu
  trong holidayDates nên không tô màu trên lịch
- Refactor holidayDates management: chuyển toàn bộ việc cập nhật
  holidayDates vào tryRenderHolidays() để tránh race condition khi
  2 API (JP và VN) trả về không đồng thời
- Fix loadHolidays: bỏ holidayDates={} ở đầu hàm để cache vẫn hiển
  thị đúng trong khi chờ API mới; reset đúng chỗ trong tryRenderHolidays
- Fix index.html: text nút toggle ban đầu đổi thành 'Tắt Mạng' cho
  khớp với trạng thái IS_ONLINE=true lúc khởi động
---
 app.js     | 9 +++++----
 index.html | 2 +-
 2 files changed, 6 insertions(+), 5 deletions(-)

diff --git a/app.js b/app.js
index b4b0d7d..111d01d 100644
--- a/app.js
+++ b/app.js
@@ -284,7 +284,7 @@ function renderWeather(data) {
 }
 
 function loadHolidays() {
-    holidayBuffer = { JP: null, VN: null }; holidayDates = {};
+    holidayBuffer = { JP: null, VN: null };
     var cached = lsGet('holiday_data');
     if (cached) {
         setHtml('holidayList', cached.html || ''); setHtml('bigHolidayList', cached.html || '');
@@ -321,7 +321,7 @@ function parseHolidaysJP(data) {
     var mo = getJST().getMonth() + 1, res = [];
     for (var ds in data) {
         var p = ds.split('-'), m2 = parseInt(p[1],10), d2 = parseInt(p[2],10);
-        if (m2 === mo) { res.push({ day: d2, label: '🇯🇵 ' + m2 + '/' + d2 + ' ' + data[ds] }); holidayDates[d2] = true; }
+        if (m2 === mo) { res.push({ day: d2, label: '🇯🇵 ' + m2 + '/' + d2 + ' ' + data[ds] }); }
     }
     return res;
 }
@@ -330,18 +330,19 @@ function parseHolidaysVN(data) {
     var mo = getJST().getMonth() + 1, res = [];
     for (var i = 0; i < data.length; i++) {
         var p = data[i].date.split('-'), m2 = parseInt(p[1],10), d2 = parseInt(p[2],10);
-        if (m2 === mo) res.push({ day: d2, label: '🇻🇳 ' + m2 + '/' + d2 + ' ' + data[i].localName });
+        if (m2 === mo) { res.push({ day: d2, label: '🇻🇳 ' + m2 + '/' + d2 + ' ' + data[i].localName }); }
     }
     return res;
 }
 
 function tryRenderHolidays() {
     if (holidayBuffer.JP === null || holidayBuffer.VN === null) return;
+    holidayDates = {};
     var all = [], i, html = '';
     for (i=0; i<holidayBuffer.JP.length; i++) all.push(holidayBuffer.JP[i]);
     for (i=0; i<holidayBuffer.VN.length; i++) all.push(holidayBuffer.VN[i]);
     all.sort(function(a,b){return a.day-b.day;});
-    for (i=0; i<all.length; i++) html += '<div class="holiday-item">' + all[i].label + '</div>';
+    for (i=0; i<all.length; i++) { holidayDates[all[i].day] = true; html += '<div class="holiday-item">' + all[i].label + '</div>'; }
     if (!html) html = '<div class="holiday-item">Không có ngày lễ</div>';
     setHtml('holidayList', html); setHtml('bigHolidayList', html);
     buildCal('calendar'); buildCal('bigCalendar');
diff --git a/index.html b/index.html
index 935f223..7942e5e 100644
--- a/index.html
+++ b/index.html
@@ -23,7 +23,7 @@
 <!-- Nút chuyển đổi Online/Offline -->
 <div id="statusWrap">
     <div id="onlineStatus" class="status-online">🟢 Online</div>
-    <button id="toggleNetBtn" onclick="toggleNetworkMode()">Chuyển Offline</button>
+    <button id="toggleNetBtn" onclick="toggleNetworkMode()">Tắt Mạng</button>
 </div>
 
 <!-- ══════════ TAB 1: INFO ══════════ -->
-- 
